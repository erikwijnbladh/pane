{
  "name": "pane",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "workspace"
  ],
  "scripts": {
    "dev": "concurrently \"node server.js\" \"npm run dev --prefix app\" \"npm run dev --prefix workspace\"",
    "build": "npm run build --workspace workspace",
    "build:app": "npm run build --workspace app",
    "build:workspace": "npm run build --workspace workspace",
    "typecheck": "npm run typecheck --workspace app && npm run typecheck --workspace workspace",
    "install:all": "npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
